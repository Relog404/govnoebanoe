# ═══════════════════════════════════════════════════════════════
# «ВИДЕОКАРТА ПРИВЕТ-1» — сценарий «Кремний»: минимальная видеокарта
# из внутриигровых компонентов. Ничего не «дорисовано» снаружи —
# каждый объект ставится и соединяется существующими деталями.
#
# Что получится на столе:
#   PWR   — блок питания 3.3 В (VCC/GND)
#   GFX   — чип MINI-8 (DIP-16) с прошивкой видеокарты, написанной ниже
#   OLED1 — 0.96" OLED 128×64; видеокарта рисует на нём «кнопку»
#           в духе HTML (<button>ПРИВЕТ</button>), кадр 1-bit
#   C1    — блокировочный конденсатор по питанию
#   BTN   — физическая тактильная кнопка; пока нажата — чип держит
#           «кадр готов» и зажигает D1 (как сигнал VSYNC у старых карт)
#   R1    — токоограничитель в цепь светодиода
#   D1    — светодиод «кадр готов»
#
# Файл: res://data/examples/video_card.silicon
# Запуск: G → окно «Кремний» → «▶ Запуск» (или Ctrl+Enter)
# Дальше: нажми BTN на плате — светодиод D1 загорится.
# ═══════════════════════════════════════════════════════════════

board 16x10                     # 160×100 мм

# ───────── Питание ─────────
place power PWR at 0,1 rot=0 volts=3.3
place capacitor C1 at 3,1 rot=0 family=ceramic

# ───────── «Видеокарта» ─────────
# io_map: порт MINI-8 = выводы чипа.
#   порт 0 → P1..P8 (шина D0..D7 к OLED, LSB → первый)
#   порт 1 → P9   (WR — защёлка OLED по спаду)
#   порт 2 → P10  (CD — 0=команда, 1=данные)
#   порт 3 → P11  (светодиод «кадр готов»)
#   порт 4 → P16  (вход кнопки BTN, активная 1)
place chip_dip16 GFX at 4,4 rot=0 pins=16 isa="res://data/isa/mini_isa.json" io_map={0=[P1,P2,P3,P4,P5,P6,P7,P8],1=P9,2=P10,3=P11,4=P16}
place oled OLED1 at 9,3 rot=0

# ───────── Обвязка ─────────
place resistor R1 at 4,7 rot=0 ohms=330
place led D1 at 7,7 rot=0 color="ff492f"
place button BTN at 2,7 rot=0 cap="b0463a"

# ───────── Пайка: шины и цепи ─────────
wire PWR.VCC -> C1.A
wire C1.B -> PWR.GND
wire PWR.VCC -> OLED1.VCC      # питание дисплея
wire OLED1.GND -> PWR.GND
wire GFX.P13 -> PWR.VCC        # питание ядра (VCC)
wire GFX.P12 -> PWR.GND        # питание ядра (GND)
wire GFX.P1 -> OLED1.D0
wire GFX.P2 -> OLED1.D1
wire GFX.P3 -> OLED1.D2
wire GFX.P4 -> OLED1.D3
wire GFX.P5 -> OLED1.D4
wire GFX.P6 -> OLED1.D5
wire GFX.P7 -> OLED1.D6
wire GFX.P8 -> OLED1.D7
wire GFX.P9 -> OLED1.WR
wire GFX.P10 -> OLED1.CD
wire GFX.P11 -> R1.A           # «кадр готов» через R1…
wire R1.B -> D1.A
wire D1.K -> PWR.GND           # …на аноде, катод в землю
wire PWR.VCC -> BTN.1          # кнопка подтянута к питанию
wire BTN.2 -> GFX.P16          # …а на вход чипа приходит 3.3 В при нажатии

note "Видеокарта собрана. Прошивка шьётся ниже блоком asm."

# ───────── Прошивка видеокарты (MINI-8, чистым текстом в скрипте) ─────────
# Порты: 0 = D0..D7, 1 = WR, 2 = CD, 3 = LED, 4 = кнопка.
# OLED: CD=0 — команды (0x81 вкл, 0xC0+page — страница, 0x00–0x7F — колонка);
#       CD=1 — данные: 8 вертикальных пикселей текущей страницы, колонка++.
# Кадр рисуется один раз при старте; дальше цикл опрашивает кнопку
# и ведёт «линию кадра готов» (порт 3).
asm GFX
        LIT R6, 1           ; константа 1
        LIT R5, 0           ; константа 0
        ; ── страница 2: верхняя перекладина HTML-кнопки (колонки 32..95) ──
        OUT 2, R5           ; CD = 0 (команды)
        LIT R0, 0xC2        ; страница 2
        OUT 0, R0
        OUT 1, R6           ; WR = 1
        OUT 1, R5           ; WR = 0 → защёлкнуть
        LIT R0, 32          ; колонка 32
        OUT 0, R0
        OUT 1, R6
        OUT 1, R5
        OUT 2, R6           ; CD = 1 (данные: 8 вертикальных px, колонка++)
        LIT R2, 64          ; колонок в перекладине
        LIT R3, 0xC0        ; строки 22–23
P2:
        OUT 0, R3
        OUT 1, R6
        OUT 1, R5
        SUB R2, R6
        JNZ R2, P2
        ; ── страница 3: стенки + «ПРИВЕТ» (читаем кадр из ROM-таблицы) ──
        OUT 2, R5           ; CD = 0
        LIT R0, 0xC3        ; страница 3
        OUT 0, R0
        OUT 1, R6
        OUT 1, R5
        LIT R0, 32          ; колонка 32
        OUT 0, R0
        OUT 1, R6
        OUT 1, R5
        OUT 2, R6           ; CD = 1
        LIT R2, 0           ; индекс в таблице BAND
        LIT R1, 64          ; длина строки в байтах
STRIPE:
        LDI R0, BAND, R2
        OUT 0, R0
        OUT 1, R6
        OUT 1, R5
        ADD R2, R6
        SUB R1, R6
        JNZ R1, STRIPE
        ; ── страница 4: нижняя перекладина (колонки 32..95) ──
        OUT 2, R5           ; CD = 0
        LIT R0, 0xC4        ; страница 4
        OUT 0, R0
        OUT 1, R6
        OUT 1, R5
        LIT R0, 32          ; колонка 32
        OUT 0, R0
        OUT 1, R6
        OUT 1, R5
        OUT 2, R6           ; CD = 1
        LIT R2, 64
        LIT R3, 0x03        ; строки 32–33
P4:
        OUT 0, R3
        OUT 1, R6
        OUT 1, R5
        SUB R2, R6
        JNZ R2, P4
MAIN:
        IN R4, 4            ; читаем кнопку (порт 4 = P16)
        OUT 3, R4           ; «кадр готов» → светодиод D1 через R1
        JMP MAIN
; 5×7, вертикальный байт = колонка, бит 0 = верхний ряд. Курсив-строчный
; «привет» рисуем прописными — уместно для плашки кнопки.
; BAND раскладывается по колонкам 32..95 страницы 3:
;   стенка FF FF, 15 пустых, «П Р И В Е Т» (6×5 байт), 15 пустых, стенка FF FF
BAND:
        DB 0xFF,0xFF
        DB 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00
        DB 0x7F,0x01,0x01,0x01,0x7F   ; П
        DB 0x7F,0x09,0x09,0x09,0x01   ; Р
        DB 0x7F,0x08,0x04,0x02,0x7F   ; И
        DB 0x7F,0x49,0x49,0x49,0x36   ; В
        DB 0x7F,0x49,0x49,0x49,0x49   ; Е
        DB 0x01,0x01,0x7F,0x01,0x01   ; Т
        DB 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00
        DB 0xFF,0xFF
end

flash GFX                       # собрать и прошить GFX, запустить
note "Готово: OLED показывает <button>ПРИВЕТ</button>. Нажми BTN — загорится D1."
