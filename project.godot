; Chip Architect — Godot 4.4+ project.
; Everything gameplay-related is data-driven: see resources/components/*.tres.
config_version=5

[application]

config/name="Chip Architect"
config/description="Build a chip from scratch, program it and play the result on a live output screen."
config/version="0.9.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1500
window/size/viewport_height=880
window/size/window_width_override=1500
window/size/window_height_override=880
window/stretch/mode="disabled"
window/handheld/orientation=1

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.058, 1)
textures/default_filters/use_nearest_mipmap_filter=false
